generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}
datasource db {
  provider = "postgresql"
  extensions = [vector]
}
enum HealthStatus {
  NOT_COMPUTED
  COMPUTING
  COMPUTED
  FAILED
}
enum OnboardingGuideStatus {
  NOT_GENERATED
  GENERATING
  GENERATED
  FAILED
}
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  repositories  Repository[]
  chatSessions ChatSession[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Repository {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  githubRepoId  BigInt   @unique @map("github_repo_id")
  name          String
  fullName      String   @map("full_name")
  owner         String
  isPrivate     Boolean  @map("is_private")
  defaultBranch String   @map("default_branch")
  pullRequests PullRequest[]
  issues       Issue[]
  chatSessions ChatSession[]
  codeChunks CodeChunk[]
  architectureDiagrams ArchitectureDiagram[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  healthStatus HealthStatus @default(NOT_COMPUTED) @map("health_status")
  lastHealthComputedAt  DateTime? @map("last_health_computed_at")
  lastHealthError       String?   @db.Text @map("last_health_error")
  healthScore           RepositoryHealthScore?
  onboardingGuide OnboardingGuide?
  indexStatus      String    @default("NOT_INDEXED") @map("index_status")
  activeIndexRunId String?   @map("active_index_run_id")
  lastIndexedAt    DateTime? @map("last_indexed_at")
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastIndexError   String?   @db.Text @map("last_index_error")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("repositories")
}

model PullRequest {
  id           String    @id @default(cuid())
  repositoryId String    @map("repository_id")
  githubPrId   BigInt    @unique @map("github_pr_id")
  number       Int
  title        String
  state        String    // "open" | "closed"
  isMerged     Boolean   @default(false) @map("is_merged")
  authorLogin  String    @map("author_login")
  baseBranch   String    @map("base_branch")
  headBranch   String    @map("head_branch")
  codeReviews CodeReview[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  githubCreatedAt DateTime @map("github_created_at")
  githubUpdatedAt DateTime @map("github_updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@map("pull_requests")
}

model Issue {
  id           String    @id @default(cuid())
  repositoryId String    @map("repository_id")
  githubIssueId BigInt   @unique @map("github_issue_id")
  number       Int
  title        String
  state        String    // "open" | "closed"
  authorLogin  String    @map("author_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  githubCreatedAt DateTime @map("github_created_at")
  githubUpdatedAt DateTime @map("github_updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@map("issues")
}

model ChatSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  repositoryId String    @map("repository_id")
  title        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id            String   @id @default(cuid())
  chatSessionId String   @map("chat_session_id")
  role          String   // "user" | "assistant" | "system"
  content       String   @db.Text
  provider      String?  // "gemini" | "groq" | "openrouter" — null for user messages
  model         String?  // e.g. "gemini-2.0-flash" — null for user messages
  sources Json? @map("sources")
  createdAt     DateTime @default(now()) @map("created_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model CodeReview {
  id            String    @id @default(cuid())
  pullRequestId String    @map("pull_request_id")
  status        String    // "pending" | "completed" | "failed"
  summary       String?   @db.Text
  provider      String?
  model         String?
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  pullRequest PullRequest         @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  findings    CodeReviewFinding[]

  @@map("code_reviews")
}

model CodeReviewFinding {
  id           String   @id @default(cuid())
  codeReviewId String   @map("code_review_id")
  filePath     String   @map("file_path")
  lineNumber   Int?     @map("line_number")
  severity     String   // "info" | "warning" | "critical"
  comment      String   @db.Text

  codeReview CodeReview @relation(fields: [codeReviewId], references: [id], onDelete: Cascade)

  @@map("code_review_findings")
}

model CodeChunk {
  id           String   @id @default(cuid())
  repositoryId String   @map("repository_id")
  indexRunId   String   @map("index_run_id")
  filePath     String   @map("file_path")
  content      String   @db.Text
  embedding    Unsupported("vector(768)")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, indexRunId])
  @@map("code_chunks")
}

model RepositoryHealthScore {
  id           String @id @default(cuid())
  repositoryId String @unique @map("repository_id")

  overallScore Int @map("overall_score")

  securityScore Int? @map("security_score")
  vulnerabilityCriticalCount Int @map("vulnerability_critical_count")
  vulnerabilityHighCount     Int @map("vulnerability_high_count")
  vulnerabilityModerateCount Int @map("vulnerability_moderate_count")
  vulnerabilityLowCount      Int @map("vulnerability_low_count")

  complexityScore         Int   @map("complexity_score")
  avgCyclomaticComplexity Float @map("avg_cyclomatic_complexity")
  highComplexityFileCount Int   @map("high_complexity_file_count")

  documentationScore    Int     @map("documentation_score")
  documentedExportRatio Float   @map("documented_export_ratio")
  hasReadme             Boolean @map("has_readme")

  activityScore     Int    @map("activity_score")
  commitsLast90Days Int    @map("commits_last_90_days")
  prMergeRate       Float? @map("pr_merge_rate")

  computedAt DateTime @default(now()) @map("computed_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("repository_health_scores")
}


model OnboardingGuide {
  id           String               @id @default(cuid())
  repositoryId String               @unique @map("repository_id")

  status       OnboardingGuideStatus @default(NOT_GENERATED)
  content      String?              @db.Text
  provider     String?
  model        String?
  lastError    String?               @db.Text @map("last_error")
  generatedAt  DateTime?             @map("generated_at")

  repository     Repository                 @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  checklistItems OnboardingChecklistItem[]

  @@map("onboarding_guides")
}

model OnboardingChecklistItem {
  id                String  @id @default(cuid())
  onboardingGuideId String  @map("onboarding_guide_id")

  order       Int
  key         String
  category    String?
  title       String
  description String? @db.Text

  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")

 onboardingGuide OnboardingGuide @relation(fields: [onboardingGuideId], references: [id], onDelete: Cascade)
  @@unique([onboardingGuideId, key])
  @@index([onboardingGuideId, order])
  @@map("onboarding_checklist_items")
}

model ArchitectureDiagram {
  id              String    @id @default(cuid())
  repositoryId    String    @map("repository_id")
  status          String    // "pending" | "completed" | "failed"
  summary         String?   @db.Text
  mermaidCode     String?   @db.Text @map("mermaid_code")
  sourceIndexRunId String?  @map("source_index_run_id")
  provider        String?
  model           String?
  errorMessage    String?   @map("error_message") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@map("architecture_diagrams")
}